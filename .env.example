# Copie para .env (nunca envie o .env ao GitHub)
PORT=3000
# Pasta do banco SQLite e dos arquivos enviados
DATA_DIR=./data
# Chave de 32 bytes em hex para criptografar identificadores (CPF/RG) e arquivos.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# true em produção atrás de HTTPS (cookie Secure)
COOKIE_SECURE=false
# E-mails (separados por vírgula) com acesso à administração técnica
ADMIN_EMAILS=
